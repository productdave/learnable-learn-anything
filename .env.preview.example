# Copy to .env.preview.local, which is git-ignored. Never paste secrets into chat.
# The dev server does NOT read .env, deployment config, or inherited backend keys.
LEARNABLE_PREVIEW_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# For a local stack using legacy JWT keys, use its service_role key here instead.
SUPABASE_SERVICE_ROLE_KEY=

# Optional generation routes. Requires db/07-provider-connections.sql and a
# 64-hex-character encryption key generated locally, never pasted into chat.
# npm run local:configure sets these up for the isolated Docker environment.
# Connecting Claude + confirming Create course plan can incur provider charges.
LEARNABLE_SETUP_GENERATION=0
LEARNABLE_PROVIDER_VAULT_KEY=

# Optional focused AI suggestions in the saved-course editor. Also requires
# generation above. Generate proposal uses the connected Claude key and may incur
# charges; opening/reviewing an editor never starts a provider request.
LEARNABLE_AI_REFINEMENT=0

# Integrated course images use the creator's connected OpenAI key. Review the
# full migration inventory through db/24-visual-designer.sql before enabling.
# Connecting a key does not generate; starting/resuming creation may incur costs.
# Both image flags and setup generation are required. All are off in this example.
LEARNABLE_GPT_IMAGES=0
LEARNABLE_IMAGE_REQUESTS=0
LEARNABLE_CREATION_IMAGES=0

# For staging, choose LEARNABLE_PREVIEW_ENV=staging and a SEPARATE Supabase project.
# The existing live project in web/js/config.js is explicitly refused.
