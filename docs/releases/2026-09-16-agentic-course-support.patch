+  border-radius: 12px;
+  background: var(--bg-elevated);
+  text-align: center;
+}
+.practice-timer-value {
+  display: block;
+  margin-bottom: var(--space-2);
+  font-family: var(--font-mono);
+  font-size: var(--font-2xl);
+  font-weight: 700;
