# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Backend AI model routing. These are non-secret model/provider choices.
# Course generation currently supports Anthropic's Messages API adapter for
# curriculum, research, and lesson writing. You can change model names without
# code changes; adding OpenAI/Gemini text generation needs an adapter.
LEARNABLE_AI_TEXT_PROVIDER=anthropic
LEARNABLE_AI_TEXT_MODEL=claude-sonnet-4-5-20250929
LEARNABLE_AI_CURRICULUM_MODEL=
LEARNABLE_AI_RESEARCH_MODEL=
LEARNABLE_AI_LESSON_MODEL=

# Integrated Visual Designer and image pipeline. Disabled in this example until
# the target database, provider vault and authenticated flow have been reviewed.
# Creator-owned OpenAI keys are encrypted in provider_connections, never an env
# OPENAI_API_KEY fallback. Migration 08 extends the protected provider allowlist.
LEARNABLE_GPT_IMAGES=0
# Durable image request writes; enable together with the image adapter above.
LEARNABLE_IMAGE_REQUESTS=0
# Legacy rollout flag for creation-image UI; images are not an optional course
# material. Current generation plans useful visuals after lesson refinement.
LEARNABLE_CREATION_IMAGES=0
LEARNABLE_IMAGE_FUNDING=creator
LEARNABLE_AI_IMAGE_PROVIDER=
LEARNABLE_AI_IMAGE_MODEL=
LEARNABLE_AI_SEARCH_PROVIDER=anthropic
LEARNABLE_AI_SEARCH_MODEL=web_search_20250305
LEARNABLE_AI_SEARCH_MAX_USES=6

# Vercel serverless cloud generation
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback, only if you have not migrated to Supabase secret keys.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Immediate, server-owned time-slice continuation. Keep off in an unconfigured
# environment; requires migration 22 and target-specific acceptance.
# This is not spending approval and never enables a paid-generation flag.
LEARNABLE_GENERATION_CONTINUATION=0
LEARNABLE_GENERATION_ORIGIN=

# Four-step setup → generation handoff (server only; disabled by default here).
# Apply db/07-provider-connections.sql before enabling. Keep this 32-byte key
# stable and backed up; changing it makes stored connections unreadable.
LEARNABLE_SETUP_GENERATION=0
LEARNABLE_PROVIDER_VAULT_KEY=
